NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=your-openai-api-key
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Billing. All except NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY are server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_or_live
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_live
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_CORE_MONTHLY_PRICE_ID=price_core_monthly
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_premium_monthly
# Optional. The annual toggle only appears when both annual prices exist.
STRIPE_CORE_ANNUAL_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=
NEXT_PUBLIC_SITE_URL=https://www.opryn.app
